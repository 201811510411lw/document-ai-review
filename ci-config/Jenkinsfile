def jenkinsServiceAccount() {
  return "jenkins-admin"
}

def jnlpImage() {
  return "prod-mirror-cn-beijing.cr.volces.com/metadata/inbound-agent:latest-jdk21"
}

def kanikoImage() {
  return "prod-mirror-cn-beijing.cr.volces.com/metadata/kaniko:latest2"
}

def pythonRuntimeImage() {
  return "prod-mirror-cn-beijing.cr.volces.com/metadata/document-ai-review-python-runtime:3.12-slim"
}

def nodeBuilderImage() {
  return "prod-mirror-cn-beijing.cr.volces.com/metadata/node:22-bookworm-slim-pnpm11.5.1"
}

def agentImagePullSecret() {
  return "jenkins-secret"
}

def kanikoDockerConfigSecret() {
  return "jenkins-secret"
}

def agentImagePullSecretsYaml() {
  if (!agentImagePullSecret().trim()) {
    return ""
  }
  return """
  imagePullSecrets:
    - name: ${agentImagePullSecret()}
"""
}

def buildKanikoPodYaml() {
  return """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: ${jenkinsServiceAccount()}
${agentImagePullSecretsYaml()}  restartPolicy: Never
  containers:
    - name: jnlp
      image: ${jnlpImage()}
    - name: kaniko
      image: ${kanikoImage()}
      imagePullPolicy: IfNotPresent
      command: ["/bin/sh"]
      args: ["-c", "sleep 3600"]
      tty: true
      stdin: true
      volumeMounts:
        - name: kaniko-secret
          mountPath: /kaniko/.docker
  volumes:
    - name: kaniko-secret
      secret:
        secretName: ${kanikoDockerConfigSecret()}
        items:
          - key: .dockerconfigjson
            path: config.json
"""
}

def cloneRepository(String url, String branch, String directory) {
  withCredentials([usernamePassword(credentialsId: 'ds-gitlab', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
    script {
      def repositoryPath = url.replace('https://', '').replace('http://', '')
      sh """#!/bin/bash
        set -e
        git clone -b '${branch}' "https://\${GIT_USERNAME}:\${GIT_PASSWORD}@${repositoryPath}" '${directory}'
      """
    }
  }
}

def buildImage(String imageName) {
  container('kaniko') {
    sh """
      /kaniko/executor \\
        --context=${env.WORKSPACE}/document-ai-review \\
        --dockerfile=ci-config/Dockerfile \\
        --build-arg PYTHON_IMAGE=${pythonRuntimeImage()} \\
        --build-arg NODE_IMAGE=${nodeBuilderImage()} \\
        --destination=${imageName} \\
        --label org.opencontainers.image.revision=${env.SOURCE_COMMIT} \\
        --label org.opencontainers.image.source=${params.GIT_REPO} \\
        --label org.opencontainers.image.version=${env.DOCUMENT_AI_REVIEW_IMAGE_TAG} \\
        --cache=true \\
        --cache-repo=${params.IMAGE_REGISTRY}/document-ai-review-cache \\
        --cache-copy-layers=true \\
        --cache-run-layers=true \\
        --cache-ttl=168h \\
        --skip-tls-verify \\
        --verbosity=info
    """
  }
}

def resolveImageTag() {
  def suppliedTag = params.IMAGE_TAG
  def requestedTag = suppliedTag.trim()
  if (suppliedTag != requestedTag) {
    error('IMAGE_TAG must not contain leading or trailing whitespace')
  }
  if (requestedTag.isEmpty()) {
    return 'v1'
  }
  def imageTag = requestedTag
    .replace('${BUILD_NUMBER}', env.BUILD_NUMBER)
    .replace('$BUILD_NUMBER', env.BUILD_NUMBER)
  if (!(imageTag ==~ /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$/)) {
    error("IMAGE_TAG is not a valid OCI tag: ${imageTag}")
  }
  return imageTag
}

pipeline {
  agent none

  parameters {
    string(name: 'GIT_REPO', defaultValue: 'https://git.lsym.cn/datacenter/data-development/document-ai-review.git', description: 'Git仓库地址')
    string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git分支')
    string(name: 'IMAGE_REGISTRY', defaultValue: 'prod-mirror-cn-beijing.cr.volces.com/metadata', description: '镜像仓库命名空间')
    string(name: 'IMAGE_TAG', defaultValue: 'v1', description: '镜像 Tag；留空则使用 v1')
  }

  stages {
    stage('Build & Push Image') {
      steps {
        script {
          podTemplate(yaml: buildKanikoPodYaml()) {
            node(POD_LABEL) {
              cloneRepository(params.GIT_REPO, params.GIT_BRANCH, 'document-ai-review')
              env.SOURCE_COMMIT = sh(
                script: 'git -C document-ai-review rev-parse HEAD',
                returnStdout: true
              ).trim()
              env.SOURCE_COMMIT_SHORT = sh(
                script: 'git -C document-ai-review rev-parse --short HEAD',
                returnStdout: true
              ).trim()
              env.SOURCE_COMMIT_SUBJECT = sh(
                script: 'git -C document-ai-review log -1 --pretty=%s',
                returnStdout: true
              ).trim()
              env.SOURCE_COMMIT_AUTHOR = sh(
                script: 'git -C document-ai-review log -1 --pretty=%an',
                returnStdout: true
              ).trim()
              env.SOURCE_COMMIT_TIME = sh(
                script: 'git -C document-ai-review log -1 --pretty=%cI',
                returnStdout: true
              ).trim()

              def imageTag = resolveImageTag()
              def imageName = "${params.IMAGE_REGISTRY}/document-ai-review:${imageTag}"
              env.DOCUMENT_AI_REVIEW_IMAGE_TAG = imageTag
              env.DOCUMENT_AI_REVIEW_IMAGE_NAME = imageName
              currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.GIT_BRANCH} ${env.SOURCE_COMMIT_SHORT} ${env.SOURCE_COMMIT_SUBJECT}"
              currentBuild.description = "commit: ${env.SOURCE_COMMIT}\nbranch: ${params.GIT_BRANCH}\nimage: ${imageName}"

              echo "Source repository: ${params.GIT_REPO}"
              echo "Source branch: ${params.GIT_BRANCH}"
              echo "Source commit: ${env.SOURCE_COMMIT}"
              echo "Source commit subject: ${env.SOURCE_COMMIT_SUBJECT}"
              echo "Source commit author: ${env.SOURCE_COMMIT_AUTHOR}"
              echo "Source commit time: ${env.SOURCE_COMMIT_TIME}"
              echo 'Source commit content:'
              sh 'git -C document-ai-review log -1 --format=fuller --stat --no-renames'
              echo "Build image: ${imageName}"
              echo "Kaniko cache: ${params.IMAGE_REGISTRY}/document-ai-review-cache (TTL: 168h)"
              buildImage(imageName)
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo "镜像已推送: ${env.DOCUMENT_AI_REVIEW_IMAGE_NAME}"
      echo "源码提交: ${env.SOURCE_COMMIT}"
    }
    failure {
      echo "构建失败，请检查 Jenkins 日志"
    }
  }
}
